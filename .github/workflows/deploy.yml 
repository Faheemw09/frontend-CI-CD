name: Deploy React App to Vercel

on: push

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Install Vercel CLI
        run: npm install --global vercel

      # Deploys directly to Vercel using only the token
      # --yes skips interactive CLI prompts
      # --prod makes it a live production deployment
      # Vercel will automatically look at your code and build it on their servers.
       Tarun: vercel --token=${{ secrets.VERCEL_TOKEN }} --yes --prod
